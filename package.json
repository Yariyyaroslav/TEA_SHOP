{
  "name": "tea-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Tea shop API with React + TypeScript SPA frontend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon src/server.js",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "mongoose": "^8.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "concurrently": "^9.1.2"
  }
}
