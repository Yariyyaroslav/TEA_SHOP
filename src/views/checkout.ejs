<%- include('partials/header') %><section class="section narrow"><h1>Оформление заказа</h1><% if (error) { %><p class="error"><%= error %></p><% } %><form class="order-form" method="post" action="/checkout"><label>Имя<input name="name" required></label><label>Телефон<input name="phone" required></label><label>Адрес доставки<textarea name="address" rows="3"></textarea></label><label>Комментарий<textarea name="comment" rows="3"></textarea></label><p class="total">К оплате: <%= total %> ₽</p><button class="button">Подтвердить заказ</button></form></section><%- include('partials/footer') %>
