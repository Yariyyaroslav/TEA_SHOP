<%- include('partials/header') %><section class="section"><h1>Корзина</h1><% if (!items.length) { %><p class="lead">В корзине пока пусто.</p><a class="button" href="/catalog">Перейти в каталог</a><% } else { %><div class="cart-list"><% items.forEach(item => { %><div class="cart-item"><span><%= item.name %> × <%= item.quantity %></span><strong><%= item.price * item.quantity %> ₽</strong><form method="post" action="/cart/remove/<%= item.teaId %>"><button class="link-button">Удалить</button></form></div><% }) %></div><h2 class="total">Итого: <%= total %> ₽</h2><a class="button" href="/checkout">Оформить заказ</a><% } %></section><%- include('partials/footer') %>
