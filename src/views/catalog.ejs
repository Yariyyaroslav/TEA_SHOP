<%- include('partials/header') %><section class="section"><p class="eyebrow">Коллекция</p><h1>Найдите свой чай</h1><div class="filters"><a class="<%= !selectedCategory ? 'active' : '' %>" href="/catalog">Все</a><% categories.forEach(category => { %><a class="<%= selectedCategory === category ? 'active' : '' %>" href="/catalog?category=<%= encodeURIComponent(category) %>"><%= category %></a><% }) %></div><div class="grid"><% teas.forEach(tea => { %><%- include('partials/card', { tea }) %><% }) %></div></section><%- include('partials/footer') %>
